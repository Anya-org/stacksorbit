{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationResult",
  "description": "Schema for ConxiusOrbit verification results",
  "type": "object",
  "required": ["timestamp", "network", "overall_status", "checks"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "network": {
      "type": "string"
    },
    "overall_status": {
      "type": "string",
      "enum": ["success", "failed", "partial", "unknown"]
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["passed"],
        "properties": {
          "passed": { "type": "boolean" },
          "error": { "type": ["string", "null"] },
          "details": { "type": "object" }
        }
      }
    },
    "contracts": {
      "type": "object"
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
