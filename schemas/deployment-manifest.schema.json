{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeploymentManifest",
  "description": "Schema for ConxiusOrbit deployment manifests",
  "type": "object",
  "required": ["timestamp", "network", "deployer", "deployment"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "network": {
      "type": "string",
      "enum": ["devnet", "testnet", "mainnet"]
    },
    "deployer": {
      "type": "string",
      "description": "Stacks address of the deployer"
    },
    "deployment": {
      "type": "object",
      "required": ["successful", "failed", "skipped"],
      "properties": {
        "successful": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "tx_id"],
            "properties": {
              "name": { "type": "string" },
              "tx_id": { "type": "string" },
              "contract_id": { "type": "string" }
            }
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "error"],
            "properties": {
              "name": { "type": "string" },
              "error": { "type": "string" }
            }
          }
        },
        "skipped": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
