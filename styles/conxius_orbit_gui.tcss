/* ConxiusOrbit GUI CSS - Modern Theme */

.standard-theme Screen {
    background: #0c0c0d;
    color: #c0c0c0;
    layout: vertical;
    padding: 1;
}

.standard-theme Header {
    background: #1e1e20;
    color: #e0e0e0;
    text-style: bold;
    padding: 1 2;
}

.standard-theme Footer {
    background: #1e1e20;
    color: #a0a0a0;
    padding: 0 2;
}

.standard-theme TabbedContent {
    background: #151516;
    border: heavy #2a2a2c;
    padding: 1;
}

.standard-theme TabPane {
    padding: 1;
}

.standard-theme Tabs {
    background: #1e1e20;
}

.standard-theme Tab {
    padding: 1 2;
    background: #1a1a1b;
    border: round #2a2a2c;
}

.standard-theme Tab:hover {
    background: #252527;
}

.standard-theme Tab:focus {
    border: round #007acc;
    background: #252527;
}

.standard-theme Tab.--current {
    background: #007acc;
    color: white;
    text-style: bold;
}

.standard-theme .metric-card {
    background: #1a1a1b;
    border: round #2a2a2c;
    padding: 1 2;
    margin: 1;
}

.standard-theme .metric-card Label {
    color: #a0a0a0;
    text-style: bold;
    margin-bottom: 1;
}

.standard-theme .metric-card Static {
    color: #e0e0e0;
    text-style: bold;
}

.standard-theme .metric-card:hover {
    background: #252527;
    border: round #007acc;
}

.standard-theme .metric-card:focus {
    background: #252527;
    border: tall #007acc;
}

.standard-theme #metrics-grid {
    layout: grid;
    grid-size: 3;
    height: auto;
    margin: 1 0;
}

.standard-theme #address-bar { height: auto; align: center middle; padding: 1 2; background: #1e1e20; border: solid #2a2a2c; margin-bottom: 1; }
.standard-theme #address-bar Label { margin: 0 1 0 0; text-style: bold; color: #a0a0a0; }
.standard-theme #address-bar Static { color: #007acc; margin-right: 1; text-style: bold; }
.standard-theme #address-bar Static:focus { color: white; background: #007acc; }
.standard-theme #address-bar Button { min-width: 4; padding: 0 1; margin: 0; height: 3; }

.standard-theme #overview-buttons {
    padding: 1 0;
    align: center middle;
}

.standard-theme #last-updated-label {
    padding: 1 2;
    color: #808080;
    height: 3;
}

.standard-theme Button {
    margin: 0 1;
    padding: 1 2;
    border: round #2a2a2c;
    background: #252527;
}

.standard-theme Button:hover {
    background: #303032;
}

.standard-theme Button:focus {
    border: round #007acc;
    background: #303032;
}

.standard-theme Button.primary {
    background: #007acc;
    color: white;
}

.standard-theme Button.success {
    background: #28a745; /* Green */
    color: white;
}

.standard-theme Button.warning {
    background: #f39c12; /* Orange */
    color: white;
}

.standard-theme Button.error {
    background: #cc3333; /* Red */
    color: white;
}

.standard-theme DataTable {
    background: #151516;
    border: heavy #2a2a2c;
}

.standard-theme DataTable .datatable--header {
    background: #1e1e20;
    text-style: bold;
}

.standard-theme DataTable .datatable--cursor {
    background: #007acc;
    color: white;
}

.standard-theme Log {
    background: #151516;
    border: heavy #2a2a2c;
    padding: 1;
}

.standard-theme Input {
    background: #252527;
    border: round #2a2a2c;
    padding: 1;
}

.standard-theme Input:focus {
    border: round #007acc;
}

.standard-theme Input.error {
    border: round #cc3333;
}

.standard-theme Input.success {
    border: round #28a745;
}

.standard-theme .input-group {
    layout: horizontal;
    align: center middle;
}

.standard-theme .input-group Input {
    width: 1fr;
    margin-right: 1;
}

.standard-theme .input-group Switch {
    width: auto;
}

.standard-theme .input-group Button {
    width: auto;
    min-width: 8;
}

.standard-theme .switch-label {
    margin: 1 1 0 2;
    color: #a0a0a0;
}

.standard-theme .clickable-label:hover {
    color: #007acc;
    text-style: underline;
}

.standard-theme LoadingIndicator {
    height: 3;
    content-align: center middle;
    width: 100%;
}

.standard-theme .details-pane {
    width: 60%;
    padding: 1;
    border-left: solid #2a2a2c;
}

.standard-theme .header {
    text-style: bold;
    color: #e0e0e0;
}

.standard-theme #contract-details-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.standard-theme #contract-details-header Label {
    width: 1fr;
    margin: 0;
}

.standard-theme #contract-details-header Button {
    min-width: 6;
    margin: 0;
    padding: 0 1;
}

.standard-theme #transaction-actions {
    height: auto;
    align: left middle;
    margin-top: 1;
    padding: 0 1;
    background: #1e1e20;
    border: solid #2a2a2c;
}

.standard-theme #transaction-actions Label {
    width: 1fr;
    margin: 0;
}

.standard-theme #transaction-actions Button {
    min-width: 6;
    margin: 0 1;
    padding: 0 1;
}

.standard-theme #tx-filter-bar {
    height: auto;
    align: center middle;
    padding: 0 1;
    margin-bottom: 1;
    background: #1e1e20;
    border: solid #2a2a2c;
}

.standard-theme #tx-filter-input {
    width: 1fr;
    margin: 0;
    border: none;
    background: transparent;
}

.standard-theme #tx-filter-input:focus {
    border: none;
    background: #252527;
}

.standard-theme #clear-tx-filter-btn {
    min-width: 4;
    padding: 0 1;
    margin: 0;
    height: 3;
    border: none;
    background: transparent;
    color: #cc3333;
}

.standard-theme #clear-tx-filter-btn:hover {
    background: #303032;
    color: #ff4444;
}

.standard-theme #tx-filter-count {
    width: auto;
    padding: 0 1;
    color: #808080;
    text-style: italic;
}
