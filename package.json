{
  "name": "stacksorbit",
  "version": "1.3.0",
  "description": "CLI-first deployment and operations toolkit for Stacks / Clarity smart contracts",
  "main": "bin/enhanced-stacksorbit.js",
  "bin": {
    "stacksorbit": "./bin/enhanced-stacksorbit.js"
  },
  "scripts": {
    "start": "node bin/enhanced-stacksorbit.js",
    "setup": "python stacksorbit_cli.py setup",
    "deploy": "python stacksorbit_cli.py deploy",
    "monitor": "python stacksorbit_cli.py monitor",
    "verify": "python stacksorbit_cli.py verify",
    "dashboard": "python stacksorbit_cli.py dashboard",
    "diagnose": "python stacksorbit_cli.py diagnose",
    "detect": "python stacksorbit_auto_detect.py",
    "check": "python conxian_testnet_deploy.py check",
    "gui": "python stacksorbit_cli.py dashboard",
    "test": "pnpm run test:vitest",
    "test:unit": "python -m pytest tests/ -q",
    "test:integration": "python -m pytest tests/integration/ -q",
    "test:gui": "pytest tests/test_gui.py",
    "test:enhanced": "pnpm run test:vitest",
    "test:vitest": "vitest run",
    "lint": "eslint bin/*.js && pylint *.py --exit-zero",
    "format": "prettier --write bin/*.js && black *.py",
    "ci": "pnpm install && python -m pip install --upgrade pip && python -m pip install -e .[dev,test] && pnpm run lint && pnpm test",
    "prepare": "python setup.py build",
    "prepublishOnly": "pnpm run lint && pnpm test",
    "install-deps": "python -m pip install -r requirements.txt"
  },
  "keywords": [
    "stacks",
    "blockchain",
    "smart-contracts",
    "deployment",
    "clarity",
    "gui",
    "devtools",
    "web3",
    "clarinet",
    "defi"
  ],
  "author": {
    "name": "Conxian-Labs",
    "email": "dev@anyachainlabs.com",
    "url": "https://anyachainlabs.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Conxian/stacksorbit.git"
  },
  "bugs": {
    "url": "https://github.com/Conxian/stacksorbit/issues"
  },
  "homepage": "https://conxian.github.io/stacksorbit/",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "dependencies": {
    "@stacks/network": "^7.3.1",
    "@stacks/transactions": "^7.4.0",
    "@stacks/wallet-sdk": "^7.4.0",
    "axios": "^1.16.1",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "lodash": "^4.18.1",
    "next": "^16.2.6"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.15",
      "lodash": "^4.18.1"
    }
  },
  "devDependencies": {
    "@stacks/clarinet-sdk": "^3.18.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^8.57.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vitest-environment-clarinet": "^3.0.2"
  },
  "python": {
    "version": ">=3.8",
    "dependencies": [
      "textual",
      "rich",
      "requests",
      "python-dotenv",
      "toml",
      "pyyaml"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
