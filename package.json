{
  "name": "conxius-orbit",
  "version": "1.2.9",
  "description": "CLI-first deployment and operations toolkit for Stacks / Clarity smart contracts",
  "main": "bin/conxius-orbit.js",
  "bin": {
    "conxius-orbit": "./bin/conxius-orbit.js"
  },
  "scripts": {
    "start": "node bin/conxius-orbit.js",
    "setup": "python conxius_orbit_cli.py setup",
    "deploy": "python conxius_orbit_cli.py deploy",
    "monitor": "python conxius_orbit_cli.py monitor",
    "verify": "python conxius_orbit_cli.py verify",
    "dashboard": "python conxius_orbit_cli.py dashboard",
    "diagnose": "python conxius_orbit_cli.py diagnose",
    "detect": "python conxius_orbit_auto_detect.py",
    "check": "python conxian_testnet_deploy.py check",
    "gui": "python conxius_orbit_cli.py dashboard",
    "test": "pnpm run test:vitest && pnpm run test:unit && pnpm run test:gui",
    "test:unit": "python -m pytest tests/ -q",
    "test:integration": "python -m pytest tests/integration/ -q",
    "test:gui": "pytest tests/test_gui.py",
    "test:enhanced": "pnpm run test:vitest",
    "test:vitest": "vitest run",
    "audit": "pnpm audit && (python -m safety check || echo \"Safety check skipped or failed\")",
    "lint": "eslint bin/*.js scripts/*.ts --fix && pylint *.py scripts/*.py && mypy . --config-file mypy.ini && black .",
    "format": "prettier --write bin/*.js scripts/*.ts && black .",
    "ci": "pnpm install && python -m pip install --upgrade pip && python -m pip install -e .[dev,test] && pnpm run format && pnpm run lint && pnpm run audit && pnpm test",
    "prepare": "python setup.py build",
    "prepublishOnly": "pnpm run lint && pnpm test",
    "install-deps": "python -m pip install -r requirements.txt"
  },
  "keywords": [
    "stacks",
    "blockchain",
    "smart-contracts",
    "deployment",
    "clarity",
    "gui",
    "devtools",
    "web3",
    "clarinet",
    "defi",
    "conxius"
  ],
  "author": {
    "name": "Conxian-Labs",
    "email": "info@conxian-labs.com",
    "url": "https://www.conxian-labs.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Conxian/conxius-orbit.git"
  },
  "bugs": {
    "url": "https://github.com/Conxian/conxius-orbit/issues"
  },
  "homepage": "https://conxian.github.io/conxius-orbit/",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "dependencies": {
    "@stacks/network": "^7.3.1",
    "@stacks/transactions": "^7.4.0",
    "@stacks/wallet-sdk": "^7.4.0",
    "axios": "^1.18.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "next": "^16.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stacks/clarinet-sdk": "^3.20.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vitest-environment-clarinet": "^3.0.2"
  },
  "python": {
    "version": ">=3.8",
    "dependencies": [
      "textual",
      "rich",
      "requests",
      "python-dotenv",
      "toml",
      "pyyaml"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.15"
    }
  }
}