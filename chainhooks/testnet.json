{
  "version": "1.0",
  "name": "Testnet Event Monitor",
  "description": "Monitors primary contracts for critical events on Testnet.",
  "chains": [
    {
      "network": "testnet",
      "webhooks": [
        {
          "name": "Placeholder get-owner Events",
          "if": {
            "scope": "contract_call",
            "contract_identifier": "ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM.placeholder",
            "method": "get-owner"
          },
          "then": {
            "http_post": {
              "url": "https://webhook.stacksorbit.com/testnet",
              "authorization_header": "Bearer ${TESTNET_WEBHOOK_TOKEN}"
            }
          }
        },
        {
          "name": "Revenue Automation Events",
          "if": {
            "scope": "contract_call",
            "contract_identifier": "ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM.revenue-automation",
            "method": "process-revenue-stx"
          },
          "then": {
            "http_post": {
              "url": "https://webhook.stacksorbit.com/testnet",
              "authorization_header": "Bearer ${TESTNET_WEBHOOK_TOKEN}"
            }
          }
        },
        {
          "name": "DLC Orchestrator Events",
          "if": {
            "scope": "contract_call",
            "contract_identifier": "ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM.dlc-orchestrator",
            "method": "open-dlc"
          },
          "then": {
            "http_post": {
              "url": "https://webhook.stacksorbit.com/testnet",
              "authorization_header": "Bearer ${TESTNET_WEBHOOK_TOKEN}"
            }
          }
        },
        {
          "name": "DLC Bond Events",
          "if": {
            "scope": "contract_call",
            "contract_identifier": "ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM.dlc-bond",
            "method": "issue-bond"
          },
          "then": {
            "http_post": {
              "url": "https://webhook.stacksorbit.com/testnet",
              "authorization_header": "Bearer ${TESTNET_WEBHOOK_TOKEN}"
            }
          }
        }
      ]
    }
  ]
}
