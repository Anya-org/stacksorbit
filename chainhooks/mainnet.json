{
  "version": "1.0",
  "name": "Mainnet Event Monitor",
  "description": "Monitors primary contracts for critical events on Mainnet.",
  "chains": [
    {
      "network": "mainnet",
      "webhooks": [
        {
          "name": "Placeholder get-owner Events",
          "if": {
            "scope": "contract_call",
            "contract_identifier": "SP2J1BCZK8Q0CP3W4R1XX9TMKJ1N1S8QZ7K0B5N8.placeholder",
            "method": "get-owner"
          },
          "then": {
            "http_post": {
              "url": "https://webhook.stacksorbit.com/mainnet",
              "authorization_header": "Bearer ${MAINNET_WEBHOOK_TOKEN}"
            }
          }
        },
        {
          "name": "Revenue Automation Events",
          "if": {
            "scope": "contract_call",
            "contract_identifier": "SP2J1BCZK8Q0CP3W4R1XX9TMKJ1N1S8QZ7K0B5N8.revenue-automation",
            "method": "process-revenue-stx"
          },
          "then": {
            "http_post": {
              "url": "https://webhook.stacksorbit.com/mainnet",
              "authorization_header": "Bearer ${MAINNET_WEBHOOK_TOKEN}"
            }
          }
        }
      ]
    }
  ]
}
